{
  // vmt.sh on cloudflare workers, assets only, no worker script needed
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vmt-web",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist",
  },
  "routes": [
    {
      "pattern": "vmt.sh",
      "custom_domain": true,
    },
  ],
}
