  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.5"
  aria-hidden="true"
>
  <polyline points="10.5 2.75 15.25 2.75 15.25 7.5"></polyline>
  <line x1="15.25" y1="2.75" x2="9" y2="9"></line>
  <path
    d="M15.25,10.5v2.75c0,1.105-.895,2-2,2H4.75c-1.105,0-2-.895-2-2V4.75c0-1.105,.895-2,2-2h2.75"
  ></path>
</svg>
