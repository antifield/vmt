# https://discord.com/developers/applications
BOT_TOKEN=your_discord_bot_token_here

# https://www.deepl.com/
DEEPL_API_KEY=your_deepl_api_key_here

# set to "true" if using DeepL's free API, "false" for Pro API
DEEPL_FREE_API=false

# optional: https://elevenlabs.io/ (Scribe STT)
# when unset, falls back to free Google Speech Recognition
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# optional: https://turso.tech/ (remote libsql database)
# when unset, uses a local file at data/vmt.db
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# optional: per-user daily audio quota in seconds (unset = unlimited)
# DAILY_LIMIT_SECONDS=300

# maximum voice message duration in seconds (default: 60 seconds)
MAX_VOICE_MESSAGE_DURATION=60
